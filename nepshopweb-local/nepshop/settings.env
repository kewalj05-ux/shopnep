# NEPSHOPWEB settings. Edit, save, then restart the server.
# Lines starting with # are ignored. No spaces around "=" needed, no quotes needed.

# 1) AI assistant key: paste your key after the = sign (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# 2) Optional: which AI model to use (cheaper = faster)
# ANTHROPIC_MODEL=claude-haiku-5-5

# 3) Admin login, used only the FIRST time the server runs (delete the "data" folder to recreate)
ADMIN_USER=kewal
ADMIN_PASS=kewal2836
